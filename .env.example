# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# For local testing with `vercel dev`, you may copy this file to .env.local (never commit it).
# These are PLACEHOLDERS - do not put real secrets in this file.

ADMIN_PASSWORD=choose-a-long-unique-password
SESSION_SECRET=generate-at-least-32-random-characters
GITHUB_TOKEN=paste-your-fine-grained-token-here
GITHUB_OWNER=your-github-username
GITHUB_REPO=ajazedits
GITHUB_BRANCH=main
